SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///firefleethq.db
ENCRYPTION_KEY=
PORT=8000
# Published host port for docker compose (maps to container 8000).
# Change this on shared servers when 8000 is already taken.
HOST_PORT=8000
SOCKETIO_ASYNC_MODE=gevent
SCRAPE_INTERVAL_MINUTES=15
SESSION_COOKIE_SECURE=False
FLASK_ENV=development
TZ=America/New_York
APP_TIMEZONE=America/New_York
